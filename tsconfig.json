{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "moduleDetection": "legacy"
  },
  "include": [
    "src/**/*.ts"
  ]
}
